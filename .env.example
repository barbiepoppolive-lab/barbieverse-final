# ============================================
# Barbieverse Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- Supabase (Required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres

# --- Admin (Required) ---
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_SESSION_SECRET=at-least-32-characters-long-secret

# --- App URL ---
PUBLIC_APP_URL=https://your-domain.com

# --- Telegram Bot (Admin Alerts — Free) ---
# Create bot: @BotFather on Telegram → /newbot → copy token
# Get chat ID: send a message to your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- WhatsApp (Manual — No API needed) ---
# WhatsApp messages are sent manually by admin via one-click buttons in admin panel
# No Facebook/Meta account needed!

# --- Optional: Email (Brevo) ---
# BREVO_API_KEY=your-brevo-key

# --- Free AI APIs (No Credit Card Required) ---
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (fastest free inference): https://console.groq.com/keys
GROQ_API_KEY=

# Mistral (best code model): https://console.mistral.ai/keys
MISTRAL_API_KEY=

# Cerebras (highest throughput): https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# --- Local AI (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (UGC Validation) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenRouter (Multi-Model API — Coding & Vision) ---
# One API key for Claude, GPT-4, Gemini, Llama, Mistral, Qwen, and more
# Sign up: https://openrouter.ai — Free tier available
# Coding model: qwen/qwen-2.5-coder-32b-instruct (best free code model)
OPENROUTER_API_KEY=

# --- xAI (Grok) ---
# High-quality reasoning and code model
# Sign up: https://console.x.ai — Free tier available
XAI_API_KEY=

# --- ComfyUI (Local Image Generation) ---
# Install: https://github.com/comfyanonymous/ComfyUI
# Required: ComfyUI running on localhost:8188
# Recommended models: Realistic Vision 5.0 (SD 1.5), face_yolov8m.pt, sam_vit_b_01ec64.pth
COMFYUI_BASE_URL=http://localhost:8188

# --- AI Router Config (Optional — override defaults) ---
# Code tasks: OpenRouter Qwen Coder (best free code model)
# AI_ROUTE_CODE_PRIMARY=openrouter
# AI_ROUTE_CODE_FALLBACK=gemini
# AI_ROUTE_CODE_MODEL=qwen/qwen-2.5-coder-32b-instruct
# Chat tasks: Groq (fastest)
# AI_ROUTE_CHAT_PRIMARY=groq
# AI_ROUTE_CHAT_FALLBACK=gemini

# --- Video Generation (fal.ai) ---
# One API key for Kling video + ElevenLabs voice + 1000+ AI models
# Sign up: https://fal.ai — Pay-per-use, no subscription needed
# Cost: ~$0.21-0.35 per 5-second video clip, ~$0.05 per 1K voice characters
FAL_KEY=

# --- Cron Automation ---
# Secret for /api/public/cron-scrape endpoint (set this to a random string)
CRON_SECRET=your-cron-secret-here

# --- Scraping Services (Paid) ---
# Phantombuster (Instagram deep scraping): https://phantombuster.com
# Plans: Starter $69/mo — 100 profile scrapes/day
PHANTOMBUSTER_API_KEY=

# Apify (Multi-platform scraping): https://apify.com
# Free tier: $5/mo credits — Instagram, Facebook, Twitter, YouTube, Telegram
APIFY_TOKEN=

# --- Social Media Monitoring (Free APIs) ---
# Twitter/X: https://developer.x.com — Free tier: 1,500 reads/month
TWITTER_BEARER_TOKEN=

# Reddit: No token needed (uses User-Agent auth)
# YouTube: https://console.cloud.google.com — Free: 10,000 units/day
YOUTUBE_API_KEY=
# Facebook: Uses Apify (already configured above)

# --- Content Publishing (Postiz Cloud — Facebook, Instagram, YouTube, LinkedIn) ---
# All four platforms are published through Postiz Cloud (https://postiz.com)
# instead of calling each platform's API directly. The user connects each
# account through Postiz's UI OAuth flow, then grabs integration IDs from
# GET /integrations.
#
# 1. Sign up / log in at app.postiz.com, go to Settings > Developers > Public API
#    and generate an API key. Set POSTIZ_API_KEY.
# 2. For each platform, go to the Postiz dashboard, connect the account via
#    Postiz's OAuth flow (no Meta/Google/LinkedIn Developer apps needed).
# 3. Run: curl -H "Authorization: <key>" https://api.postiz.com/public/v1/integrations
#    to list connected accounts and copy each integration's _id.
# 4. Set the corresponding _INTEGRATION_ID below.
#
# Moj has no public API — content is delivered to Telegram for manual
# upload instead (uses TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID above, nothing
# extra to configure).
#
# Reddit is intentionally NOT included here — auto-posting promotional
# content to Reddit is one of the fastest ways to get an account banned by
# its own spam detection. Keep Reddit manual and human-run.
# Leave blank for Postiz Cloud (https://api.postiz.com/public/v1).
# For the self-hosted Railway instance use:
#   https://postiz-app-production-8022.up.railway.app/api/public/v1
POSTIZ_BASE_URL=
POSTIZ_API_KEY=
FACEBOOK_INTEGRATION_ID=
INSTAGRAM_INTEGRATION_ID=
YOUTUBE_INTEGRATION_ID=
LINKEDIN_INTEGRATION_ID=

# --- Content Quality Gate ---
# The publish pipeline runs fully automatic — nobody reviews a draft before
# it goes out — so this threshold (0-100, see scoreContent in
# src/lib/ai/content-quality.ts) is the safety net. Below it, a draft gets
# one AI rewrite pass; still below after that, it's sent to Telegram as
# "needs_review" instead of being published or silently skipped.
CONTENT_QUALITY_THRESHOLD=60

# --- Dev Only ---
# DB_SSL_INSECURE=true
